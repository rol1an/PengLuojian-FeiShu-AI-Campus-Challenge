# LLM provider: anthropic | openai | doubao
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Required when LLM_PROVIDER=openai (or OpenAI-compatible gateway)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Required when LLM_PROVIDER=doubao (Volcengine Ark, OpenAI-compatible)
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Feishu / lark-cli
LARK_CLI_PATH=lark-cli
LARK_CLI_AS=bot
LARK_CLI_TIMEOUT=30
CALENDAR_ID=primary

# Workflow 1: Pre-meeting knowledge push
PREMEET_PUSH_MINUTES=10
PREMEET_LOOKAHEAD_HOURS=2
PREMEET_POLL_INTERVAL=60
WIKI_MAX_DOCS=5
WIKI_SPACE_ID=

# Workflow 2: Post-meeting action items
EVENT_FILTER=vc\.meeting
TASK_DEFAULT_DUE_DAYS=3

# LLM
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
